NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toll_booth
PUBLIC_ORIGIN=http://localhost:3000

# The network selects the defaults below. A Horizon endpoint belonging to the
# other network is refused at startup rather than used to verify a payment
# against a ledger the caller never paid on.
STELLAR_NETWORK=PUBLIC
STELLAR_RPC_URL=https://stellar.api.onfinality.io/public
STELLAR_HORIZON_URL=https://horizon.stellar.org

# Required. Every payment challenge is made out to this account, and the API
# refuses to start without it rather than invoicing an address fixed in source.
PAYMENT_RECIPIENT=GCKJEORLGORT3BOUME2DQJQPKRSKST55BIZOSDZTNJ7FIGIV4KQMDDPX
PAYMENT_ASSET=native

# Inlined into the browser bundle at build time, so set these before building.
NEXT_PUBLIC_STELLAR_NETWORK=PUBLIC
NEXT_PUBLIC_STELLAR_RPC_URL=https://stellar.api.onfinality.io/public
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CAUZWSIVXANXFQWJWY4QYWCZUBV7NNSG54C7IRYI2MY7DY2UYDIDLG7X
